!recordings/eval/*.wav
recordings/topk_*.csv
recordings/run_*_events.jsonl

# Local state
backend/calibration.json
*.sqlite
*.log
.env
.vscode/
.idea/

# Generated Phase 2 demonstration manifests and local outputs
/artifacts/phase2/
/artifacts/phase3/

# Reviewed, compact aggregate serving snapshot (contains no raw acoustic events)
!bda/reports/phase4/history.sqlite
/frontend/test-results/
/frontend/playwright-report/
/artifacts/phase5/
